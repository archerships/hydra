"""hydra-convert-tables — Replace HTML tables with screenshotted PNGs.

Usage:
  hydra-convert-tables INPUT.html --out OUTPUT.html --img-dir DIR --base-url URL

Finds every <table> in the HTML, screenshots it via Chromium CDP, saves as PNG
in --img-dir, and replaces the table markup with an <img> tag pointing at
--base-url/<table-N>.png. Tables that are already inside <figure> wrappers are
preserved as-is (they were manually prepared).

Requires Chromium running with --remote-debugging-port=9222.
"""

import argparse
import hashlib
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

CDP_URL = "http://localhost:9222"


def ensure_chromium():
    try:
        urllib.request.urlopen(CDP_URL + "/json/version", timeout=2)
        return
    except urllib.error.URLError:
        pass
    subprocess.Popen(
        ["open", "-a", "/Applications/Chromium.app", "--args",
         "--remote-debugging-port=9222", "--no-first-run",
         "--no-startup-window", "--new-window"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(40):
        time.sleep(1)
        try:
            urllib.request.urlopen(CDP_URL + "/json/version", timeout=2)
            return
        except urllib.error.URLError:
            continue
    sys.exit("Chromium CDP timeout")


def screenshot_table(page, table_html: str, idx: int, img_dir: Path,
                     base_url: str, css_path: str | None = None) -> str:
    """Render a single table in a minimal HTML page and screenshot it."""
    css_link = f'<link rel="stylesheet" href="{css_path}">' if css_path else ""
    html = f"""<!DOCTYPE html>
<html><head><meta charset="utf-8">{css_link}
<style>body{{background:#000;color:#fff;font-family:system-ui,sans-serif;padding:20px;width:fit-content;}}</style>
</head><body>{table_html}</body></html>"""

    h = hashlib.md5(table_html.encode()).hexdigest()[:8]
    tmp = img_dir / f"_table-tmp-{idx}-{h}.html"
    tmp.write_text(html, encoding="utf-8")
    page.goto("file://" + str(tmp), wait_until="networkidle")
    page.wait_for_timeout(500)

    table_el = page.locator("table").first
    if not table_el.count():
        tmp.unlink()
        return None
    table_el.scroll_into_view_if_needed()
    page.wait_for_timeout(300)

    out = img_dir / f"table-{idx}.png"
    table_el.screenshot(path=str(out))
    tmp.unlink()
    return f"{base_url}/table-{idx}.png"


def convert(html_path: str, out_path: str, img_dir: Path, base_url: str,
            css_path: str | None = None):
    with open(html_path, encoding="utf-8") as f:
        html = f.read()

    # Find all tables not inside <figure> wrappers
    tables = list(re.finditer(r"<table\b.*?</table>", html, re.DOTALL))
    if not tables:
        print("No tables found.")
        copy(html_path, out_path)
        return

    print(f"Found {len(tables)} table(s).")

    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        browser = p.chromium.connect_over_cdp(CDP_URL)
        ctx = browser.contexts[0] if browser.contexts else browser.new_context()
        page = ctx.new_page()
        page.set_viewport_size({"width": 1200, "height": 800})

        for i, m in enumerate(reversed(tables), 1):
            table_html = m.group(0)
            # Skip tables already inside figure wrappers
            before = html[:m.start()]
            if before.rfind("<figure") > before.rfind("</figure>"):
                continue
            url = screenshot_table(page, table_html, i, img_dir, base_url, css_path)
            if url:
                caption_match = re.search(
                    r"Table\.\d+\.([\w-]+)", before[-200:])
                caption = caption_match.group(1) if caption_match else f"Table {i}"
                img_tag = (f'<figure><img src="{url}" alt="{caption}" '
                           f'loading="lazy" width="1200"><figcaption>'
                           f'{caption}</figcaption></figure>')
                html = html[:m.start()] + img_tag + html[m.end():]
                print(f"  Table {i}: {url}")

        browser.close()

    Path(out_path).write_text(html, encoding="utf-8")
    print(f"Wrote: {out_path}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", help="Input HTML file")
    parser.add_argument("--out", required=True, help="Output HTML file")
    parser.add_argument("--img-dir", required=True, help="Directory for PNGs")
    parser.add_argument("--base-url", required=True,
                        help="Base URL for image src attributes")
    parser.add_argument("--css", help="Path to CSS file for table styling")
    args = parser.parse_args()

    img_dir = Path(args.img_dir)
    img_dir.mkdir(parents=True, exist_ok=True)
    ensure_chromium()
    convert(args.input, args.out, img_dir, args.base_url, args.css)


if __name__ == "__main__":
    main()
