def _run(cmd: list[str], dry_run: bool, label: str) -> bool:
    print(f'  Running {label}...')
    print(f'  $ {" ".join(cmd)}')
    if dry_run:
        print('  [dry-run] skipped.')
        return True
    # 600s: CDP publishers drive a real browser and x-publisher waits for
    # the operator's manual paste approval -- 300 would kill a slow but
    # legitimate interactive publish. (Plan B3 decision: 300s for batch
    # launchers, 600s for interactive browser drivers.)
    try:
        result = subprocess.run(cmd, timeout=600)
    except subprocess.TimeoutExpired:
        print(f'  FAILED: {label} timed out after 600s.')
        return False
    return result.returncode == 0


def pub_twitter_article(slug: str, image: Path | None, dry_run: bool) -> bool:
    # Spawn with sys.executable (the hydra venv python): x-publisher uses
    # PEP 604 annotations and crashes under /usr/bin/python3 3.9.
    cmd = [sys.executable, str(BIN / 'x-publisher.py'), str(get_dst_html(slug))]
    if image and image.exists():
        cmd += ['--image', str(image)]
    return _run(cmd, dry_run, 'x-publisher')


def pub_facebook(slug: str, fm: dict, dry_run: bool) -> bool:
    """Publish to Facebook using the pfp plaintext pipeline (the guideline).

    The FB post body is the plaintext reflow of the essay source markdown
    (via pfp.render_body): URLs stripped, markdown emphasis removed, list
    markers KEPT, one blank line between paragraphs, footnote definitions
    moved to the comment. The essay URL + contact block go in a comment
    (Facebook downranks linked posts).
    """
    # Reuse pfp's canonical plaintext pipeline (single source of truth).
    # pfp is extension-less (~/av/bin/pfp), so spec_from_file_location
    # returns None -- load via exec into a fresh module.
    import types

    pfp_path = Path.home() / "av" / "bin" / "pfp"
    pfp = types.ModuleType("pfp_module")
    exec(compile(pfp_path.read_text(encoding="utf-8"), "pfp", "exec"), pfp.__dict__)

    md_path = find_source_md(slug)
    if not md_path.exists():
        print(f"  [WARN] source md not found: {md_path}; falling back to HTML text")
        soup = BeautifulSoup(get_dst_html(slug).read_text(encoding='utf-8'), 'html.parser')
        main_el = soup.find('main') or soup.find('body') or soup
        for el in main_el.find_all(id=['site-breadcrumb', 'site-nav', 'site-footer',
                                       'also-published', 'contact-snippet']):
            el.decompose()
        for el in main_el.find_all(class_='also-published'):
            el.decompose()
        full_text = main_el.get_text('\n', strip=True)
        body = re.sub(r'\n{3,}', '\n\n', full_text).strip()
    else:
        raw = md_path.read_text(encoding='utf-8')
        body = pfp.strip_frontmatter(raw)
        body = pfp.render_body(body)

    if not body:
        body = fm.get('title', slug)
    # Body must NOT contain the essay URL (Facebook downranks linked posts).
    # fb-publisher builds the comment from --essay-url + contact file instead.
    url = f'{BASE_URL}/{slug}.html'
    TMP.mkdir(parents=True, exist_ok=True)
    text_file = TMP / f'hydra-fb-{slug}.txt'
    if not dry_run:
        text_file.write_text(body, encoding='utf-8')
    cmd = [sys.executable, str(BIN / 'fb-publisher.py'), str(text_file), '--essay-url', url,
           '--essay-dir', str(essay_dir(slug))]
    return _run(cmd, dry_run, 'fb-publisher')


def pub_substack(slug: str, image: Path | None, dry_run: bool) -> bool:
