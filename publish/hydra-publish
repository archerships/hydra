# ---------------------------------------------------------------------------
# Essay directory helpers
# ---------------------------------------------------------------------------

def essay_dir(slug: str) -> Path:
    return CONTENT_DIR / slug


def find_source_md(slug: str) -> Path:
    """Return path to the source .md for slug (directory-based or flat fallback)."""
    d = essay_dir(slug)
    if d.is_dir():
        # Current convention: SLUG/SLUG.md
        canonical = d / f'{slug}.md'
        if canonical.exists():
            return canonical
        # Legacy naming: SLUG/SLUG-source-v*.md
        candidates = sorted(d.glob(f'{slug}-source-v*.md'), reverse=True)
        if candidates:
            return candidates[0]
    # Flat layout fallback
    return CONTENT_DIR / f'{slug}.md'


def find_cover_image(slug: str) -> Path | None:
    """Return the highest-versioned cover image in the essay directory, or None."""
    d = essay_dir(slug)
    if not d.is_dir():
        return None
    for ext in ('jpg', 'jpeg', 'png', 'webp'):
        candidates = sorted(d.glob(f'{slug}-cover-v*.{ext}'), reverse=True)
        if candidates:
            return candidates[0]
    return None


def next_asset_version(slug: str, platform: str) -> int:
    """Return the next version number for a platform-specific asset in the essay dir."""
    d = essay_dir(slug)
    if not d.is_dir():
        return 1
    existing = []
    for ext in ('jpg', 'jpeg', 'png', 'webp'):
        existing.extend(d.glob(f'{slug}-{platform}-v*.{ext}'))
    if not existing:
        return 1
    versions = [int(m.group(1)) for f in existing if (m := re.search(r'-v(\d+)-', f.name))]
    return max(versions) + 1 if versions else 1


def _latest_versioned(d: Path, slug: str, platform: str, fmt: str) -> Path | None:
    """Return the highest-versioned asset file for (slug, platform, fmt), or None."""
    candidates = list(d.glob(f'{slug}-{platform}-v*.{fmt}'))
    if not candidates:
        return None
    def _vkey(p: Path) -> int:
        m = re.search(r'-v(\d+)-', p.name)
        return int(m.group(1)) if m else 0
    return max(candidates, key=_vkey)


# ---------------------------------------------------------------------------
# Frontmatter
# ---------------------------------------------------------------------------

def _split_frontmatter(text: str) -> tuple[str, str]:
    """Return (fm_yaml, body). Raises ValueError if no frontmatter block."""
    if not text.startswith('---'):
        raise ValueError('No frontmatter block found')
    parts = text.split('---', 2)
    if len(parts) < 3:
        raise ValueError('Incomplete frontmatter block')
    return parts[1], parts[2]


def read_frontmatter(slug: str) -> dict:
    path = find_source_md(slug)
    if not path.exists():
        sys.exit(f'Essay not found: {path}')
    try:
        fm_yaml, _ = _split_frontmatter(path.read_text(encoding='utf-8'))
        return yaml.safe_load(fm_yaml) or {}
    except (ValueError, yaml.YAMLError) as exc:
        sys.exit(f'Could not parse frontmatter: {exc}')


def already_published(fm: dict, platform: str) -> bool:
    return any(e.get('platform') == platform and e.get('url')
               for e in (fm.get('published_at') or []))


def record_published(slug: str, platform: str, url: str = '') -> None:
    """Append a published_at entry. Rewrites frontmatter via yaml.dump."""
    if platform == 'nostr' and not url:
        print(f'  Skipping frontmatter update for {platform}: naddr URL is required '
              f'(run nak encode naddr manually and add the entry).')
        return
    path = find_source_md(slug)
    text = path.read_text(encoding='utf-8')
    try:
        fm_yaml, body = _split_frontmatter(text)
    except ValueError:
        print(f'  WARNING: could not update frontmatter for {slug}')
        return
    fm = yaml.safe_load(fm_yaml) or {}
    pub_at = fm.get('published_at') or []
    if not isinstance(pub_at, list):
        pub_at = []
    pub_at.append({'platform': platform, 'url': url, 'date': str(date.today())})
    fm['published_at'] = pub_at
    new_yaml = yaml.dump(fm, default_flow_style=False, allow_unicode=True)
    path.write_text(f'---\n{new_yaml}---\n{body}', encoding='utf-8')
    print(f'  Recorded in frontmatter: platform={platform} url={url or "(fill in manually)"}')


