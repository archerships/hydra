def cmd_create(args) -> None:
    slug = args.slug
    fm = read_frontmatter(slug)
    print(f'Essay  : {slug}')
    print(f'Title  : {fm.get("title", slug)}')
    platforms = _resolve_platforms(args)
    if args.dry_run:
        print('[DRY RUN -- no files modified, no posts sent]')
    print()

    if not platforms:
        # Legacy: require --platforms/--all (matches old behavior)
        sys.exit('create requires --platforms or --all')

    source_image = Path(os.path.expanduser(args.image)) if args.image else None
    if source_image is None:
        source_image = find_cover_image(slug)
        if source_image:
            print(f'Cover image: {source_image.name}')

    results: dict[str, str] = {}

    for platform in platforms:
        print(f'=== {platform} ===')
        if already_published(fm, platform):
            print('  Already in published_at; skipping.')
            print('  To re-publish, remove the entry from the frontmatter first.')
            results[platform] = 'skipped'
            print()
            continue

        adapted = None
        if platform not in NO_ADAPT_PLATFORMS and platform in IMAGE_CONTEXT:
            adapted = adapt_image(source_image, IMAGE_CONTEXT[platform],
                                  slug, platform, args.dry_run) if source_image else None

        ok = False
        pub_url = ''
        if platform == 'twitter-article':
            ok = pub_twitter_article(slug, adapted, args.dry_run)
        elif platform == 'facebook':
            ok = pub_facebook(slug, fm, args.dry_run)
        elif platform == 'substack':
            ok = pub_substack(slug, adapted, args.dry_run)
            if ok and not args.dry_run:
                url_script = BIN / 'substack-post-url.py'
                if url_script.exists():
                    print('  Fetching Substack URL ...')
                    try:
                        r = subprocess.run([sys.executable, str(url_script), slug],
                                           capture_output=True, text=True, timeout=300)
                    except subprocess.TimeoutExpired:
                        r = None
                        print('  WARNING: substack URL fetch timed out.')
                    if r is not None:
                        print(r.stdout.strip())
        elif platform == 'nostr':
            ok, pub_url = pub_nostr(slug, fm, adapted, args.image_url, args.dry_run)
        elif platform == 'signal':
            ok = pub_signal(slug, args.dry_run, args.arweave, args.pdf, args.epub)
        elif platform == 'odysee':
            ok, pub_url = pub_odysee(slug, fm, args, adapted)

        if ok:
            results[platform] = 'ok'
            if not args.dry_run:
                record_published(slug, platform, pub_url)
        else:
            results[platform] = 'failed'
            print(f'  FAILED.')
        print()

    published = [p for p, r in results.items() if r == 'ok']
    print('=== Summary ===')
    for platform, result in results.items():
        print(f'  {platform:20s} {result}')
    if published and not args.dry_run:
        print(f'\nFill in published URLs in: {_md_for_slug(slug)}')


def _crud_platforms(args) -> list[str]:
    """Platforms for CRUD verbs: explicit list, or infer from frontmatter refs."""
    explicit = _resolve_platforms(args)
    if explicit:
        return explicit
    return []


def cmd_read(args) -> None:
    model, registry = _crud_imports()
    slug = args.slug
    platforms = _crud_platforms(args)
    md = _md_for_slug(slug)
    ctx = _build_ctx(args, slug)

    from essay_frontmatter import get_platform_ref

    if not platforms:
        fm = read_frontmatter(slug)
        platforms = [e.get('platform') for e in (fm.get('published_at') or [])]

    print(f'Reading status for {slug} on: {", ".join(platforms) or "(none recorded)"}')
    for platform in platforms:
        print(f'=== {platform} ===')
        try:
            plugin = registry.get(platform)
        except Exception as e:
            print(f'  No plugin: {e}')
            continue
        ref_dict = get_platform_ref(md, platform)
        if not ref_dict:
            print('  No published_at entry for this platform.')
            continue
        ref = model.PlatformRef.from_dict({**ref_dict, 'platform': platform})
        status = plugin.read(ref, ctx)
        print(f'  exists: {status.exists}')
        print(f'  url:    {status.url or "-"}')
        print(f'  id:     {status.post_id or "-"}')
        if status.note:
            print(f'  note:   {status.note}')


