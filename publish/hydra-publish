def load_nostr_snippet() -> str:
    path = ARCHERSHIPS / 'src' / 'essays' / 'contact-snippet.txt'
    if path.exists():
        return path.read_text(encoding='utf-8').strip()
    return ''


def essay_to_markdown(slug: str, image_url: str | None = None) -> str:
    """Convert the built essay HTML to markdown for Nostr kind 30023.

    Relative image srcs are rewritten to absolute URLs so Nostr clients can
    load them. The primary (hero) image favors the permanent Arweave URL
    (image_url, e.g. https://arweave.net/{txId}) passed from pub_nostr; the
    archerships.com essay URL is only a fallback for non-uploaded images.
    """
    from urllib.parse import urljoin
    import html2text
    soup = BeautifulSoup(get_dst_html(slug).read_text(encoding='utf-8'), 'html.parser')
    main_el = soup.find('main') or soup.find('body') or soup
    # Strip nav/footer/contact-snippet elements
    for el in main_el.find_all(id=['site-breadcrumb', 'site-nav', 'site-footer',
                                   'also-published', 'contact-snippet']):
        el.decompose()
    for el in main_el.find_all(class_='also-published'):
        el.decompose()
    # Rewrite relative image src to absolute URLs so Nostr clients can load them
    essay_url = f'{BASE_URL}/{slug}.html'
    hero_img = main_el.find('img')
    for img in main_el.find_all('img'):
        src = img.get('src', '')
        if src and not src.startswith(('http://', 'https://', 'data:')):
            if img is hero_img and image_url:
                # Hero is promoted to the cover via the Nostr image tag
                # (rendered once by clients); drop it from the body so it
                # does not appear twice. Fixed 2026-08-13.
                parent = img.parent
                if parent and parent.name == 'a' and parent.find_all('img') == [img]:
                    parent.decompose()
                else:
                    img.decompose()
            else:
                img['src'] = urljoin(essay_url, src)
    h = html2text.HTML2Text()
    h.ignore_links = False
    h.ignore_images = False
    h.body_width = 0
    return h.handle(str(main_el)).strip()


def upload_to_arweave(image_path: Path, dry_run: bool) -> str | None:
    script = SCRIPTS_DIR / 'arweave-upload.mjs'
    if dry_run:
        print(f'  [dry-run] would upload {image_path.name} to Arweave')
        return 'https://arweave.net/DRY_RUN_PLACEHOLDER'
    print(f'  Uploading {image_path.name} to Arweave...')
    result = subprocess.run(
        ['node', str(script), str(image_path)],
        capture_output=True, text=True, cwd=str(ARCHERSHIPS), timeout=300,
    )
    if result.returncode != 0:
        print(f'  WARNING: Arweave upload failed: {result.stderr.strip()}')
        return None
    url = result.stdout.strip()
    print(f'  Arweave image URL: {url}')
    return url


def pub_nostr(slug: str, fm: dict, adapted_image: Path | None,
              image_url: str | None, dry_run: bool) -> tuple[bool, str]:
    title = fm.get('title', slug)
    url = f'{BASE_URL}/{slug}.html'
    snippet = load_nostr_snippet()
    tags_raw = fm.get('tags') or []
    tags_str = ','.join(str(t).strip('"') for t in tags_raw) if tags_raw else ''

    _, summary = extract_intro(slug)

    # Auto-upload adapted image to Arweave if no URL already supplied.
    # Favor the permanent https://arweave.net/{txId} URL for the hero image
    # so Nostr clients can render it without depending on archerships.com.
    if not image_url and adapted_image and adapted_image.exists():
        image_url = upload_to_arweave(adapted_image, dry_run)

    # Write full markdown body to a temp file (avoids shell quoting issues)
    markdown = essay_to_markdown(slug, image_url=image_url)
    if snippet:
        markdown = f'{markdown}\n\n---\n\n{snippet}'
    TMP.mkdir(parents=True, exist_ok=True)
    md_file = TMP / f'hydra-nostr-{slug}.md'
    if not dry_run:
        md_file.write_text(markdown, encoding='utf-8')

    cmd = [sys.executable, str(BIN / 'nostr-publisher.py'),
           '--kind', '30023',
           '--file', str(md_file),
           '--title', title,
           '--slug', slug,
           '--url', url]
    if summary:
        cmd += ['--summary', summary]
    if tags_str:
        cmd += ['--tags', tags_str]
    if image_url:
        cmd += ['--image-url', image_url]
    if dry_run:
        cmd += ['--dry-run']
        print(f'  Running nostr-publisher...')
        print(f'  $ {" ".join(cmd)}')
        print('  [dry-run] skipped.')
        return True, ''

    print(f'  Running nostr-publisher...')
    print(f'  $ {" ".join(cmd)}')
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    except subprocess.TimeoutExpired:
        print('  FAILED: nostr-publisher timed out after 600s.')
        return False, ''
    sys.stdout.write(result.stdout)
    if result.stderr:
        sys.stderr.write(result.stderr)
    nostr_url = ''
    for line in result.stdout.splitlines():
        if line.startswith('NOSTR_URL='):
            nostr_url = line[len('NOSTR_URL='):]
    return result.returncode == 0, nostr_url


def pub_signal(slug: str, dry_run: bool, arweave: bool = False,
               pdf: bool = False, epub: bool = False) -> bool:
    """Publish to Signal groups (default = sfa: full + announce).

    Delegates to hydra-signal --both SLUG, which sends the full post
    (text + hero + inline images) to the SIGNALFULL group list and an
    announcement (title, first paragraph, post URL, contact page link,
    hero image) to the SIGNALANNOUNCE list.
    """
    script = BIN / 'hydra-signal'
    cmd = [str(script), '--both', slug]
    if arweave:
        cmd += ['--arweave']
    if pdf:
        cmd += ['--pdf']
    elif epub:
        cmd += ['--epub']   # explicit EPUB (same as hydra-signal default)
    if dry_run:
        cmd += ['--dry-run']
    print(f'  Running hydra-signal (sfa)...')
    print(f'  $ {" ".join(cmd)}')
    if dry_run:
        return True
    try:
        # 600s: signal sends include media attachment uploads.
        result = subprocess.run(cmd, timeout=600)
    except subprocess.TimeoutExpired:
        print('  FAILED: hydra-signal timed out after 600s.')
        return False
    return result.returncode == 0


# ---------------------------------------------------------------------------
# Odysee (video/article platform via the first-party API plugin)
# ---------------------------------------------------------------------------

def pub_odysee(slug: str, fm: dict, args, adapted: Path | None) -> tuple[bool, str]:
    """Publish to Odysee via the hydra_crud plugin (first-party TUS upload).

    Delegates to OdyseePlugin.create with the same ctx dict the CRUD verbs
    build, so the plugin's keyring auth (service 'odysee') and its TUS
    upload flow are the single implementation (see
    hydra_crud/plugins/odysee.py).
    """
    model, registry = _crud_imports()
    plugin = registry.get('odysee')

    # odysee channel claim id from keyring (plugin resolves); post type:
    # video when the essay dir has a video file, else article.
    ctx = _build_ctx(args, slug)
    post_dict = _load_post_from_repo(args, slug)
    post_dict['post_type'] = 'video'
    # Explicit --image becomes the claim thumbnail (plugin uploads it to
    # Arweave); without it the plugin extracts a video frame.
    if getattr(args, 'image', None):
        post_dict['cover_image'] = str(Path(args.image).expanduser().resolve())
    post = model.Post(**post_dict)

    try:
        ref = plugin.create(post, ctx)
    except Exception as exc:
        print(f'  FAILED: {exc}')
        return False, ''
    print(f'  odysee: {ref.url or ref.post_id}')
    return True, ref.url or ''


