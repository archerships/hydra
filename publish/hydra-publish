def cmd_sync(args) -> None:
    """Sync a post from SRC to one or more DST platforms (D9 upsert)."""
    model, registry = _crud_imports()
    slug = args.slug
    md = _md_for_slug(slug)
    ctx = _build_ctx(args, slug)

    from essay_frontmatter import get_platform_ref, set_platform_ref

    src = args.src
    dsts = [d.strip() for d in args.dst.split(',') if d.strip()]
    if not dsts:
        sys.exit('sync requires --to (comma-separated destinations)')

    # Resolve the source Post.
    if src in ('repo', 'website'):
        if src == 'repo':
            # Source of truth = the .md + images in ~/av/doc/posts/SLUG/
            post_dict = _load_post_from_repo(args, slug)
        else:
            # Explicit website source = the built HTML (debug/deploy checks)
            post_dict = _load_post(args, slug)
        post = model.Post(**post_dict)
        print(f'Source : {src} ({slug})')
    else:
        try:
            src_plugin = registry.get(src)
        except Exception as e:
            sys.exit(f'No plugin for source platform "{src}": {e}')
        # Reverse flow: fetch the Post from the SRC platform.
        src_ref_dict = get_platform_ref(md, src)
        if not src_ref_dict:
            sys.exit(f'No published_at entry for source platform "{src}" '
                     f'-- cannot fetch the post to sync from.')
        src_ref = model.PlatformRef.from_dict({**src_ref_dict, 'platform': src})
        fetched = getattr(src_plugin, 'fetch_post', None)
        if fetched is None:
            sys.exit(f'Plugin "{src}" does not support fetch_post (needed for --from {src}).')
        try:
            post = fetched(src_ref, ctx)
        except NotImplementedError as e:
            sys.exit(f'--from {src} not available yet: {e}')
        print(f'Source : {src} ({src_ref.url or src_ref.post_id})')

    print(f'Targets: {", ".join(dsts)}')
    if args.dry_run:
        print('[DRY RUN -- no posts sent, no files modified]')
    print()

    for dst in dsts:
        print(f'=== {dst} ===')
        try:
            plugin = registry.get(dst)
        except Exception as e:
            print(f'  No plugin: {e}')
            continue

        ref_dict = get_platform_ref(md, dst)
        try:
            if ref_dict:
                ref = model.PlatformRef.from_dict({**ref_dict, 'platform': dst})

                # Conflict rule (D9): never clobber a newer DST post.
                src_date = getattr(post, 'updated_at', '') or ''
                dst_date = ref.updated_at or ''
                if src_date and dst_date and src_date < dst_date:
                    print(f'  SKIP: SRC ({src_date}) older than DST ref ({dst_date}).')
                    continue

                new_ref = plugin.update(ref, post, ctx)
                action = 'updated'
            else:
                new_ref = plugin.create(post, ctx)
                action = 'created'
            if not args.dry_run:
                set_platform_ref(md, dst, new_ref.to_dict())
            print(f'  {action}: {new_ref.url or new_ref.post_id}')
        except NotImplementedError as e:
            print(f'  SKIP: {e}')
        except Exception as e:
            print(f'  FAILED: {e}')


def cmd_propagate(args) -> None:
    model, registry = _crud_imports()
    slug = args.slug
    md = _md_for_slug(slug)
    ctx = _build_ctx(args, slug)
    post_dict = _load_post(args, slug)
    post = model.Post(**post_dict)

    from essay_frontmatter import get_platform_ref, set_platform_ref

    fm = read_frontmatter(slug)
    platforms = [e.get('platform') for e in (fm.get('published_at') or [])]

    print(f'Propagating {slug} to {len(platforms)} platform(s) with refs...')
    for platform in platforms:
        print(f'=== {platform} ===')
        try:
            plugin = registry.get(platform)
        except Exception as e:
            print(f'  No plugin: {e}')
            continue
        ref_dict = get_platform_ref(md, platform)
        if not ref_dict:
            continue
        ref = model.PlatformRef.from_dict({**ref_dict, 'platform': platform})
        try:
            new_ref = plugin.update(ref, post, ctx)
            if not args.dry_run:
                set_platform_ref(md, platform, new_ref.to_dict())
            print(f'  updated: {new_ref.url or new_ref.post_id}')
        except NotImplementedError:
            print('  Plugin has no update; skipped.')
        except Exception as e:
            print(f'  FAILED: {e}')

    if args.include_new:
        print('=== creating on platforms without refs ===')
        for platform in ALL_PLATFORMS:
            if platform in platforms:
                continue
            print(f'=== {platform} ===')
            try:
                plugin = registry.get(platform)
            except Exception:
                continue
            try:
                new_ref = plugin.create(post, ctx)
                if not args.dry_run:
                    set_platform_ref(md, platform, new_ref.to_dict())
                print(f'  created: {new_ref.url}')
            except Exception as e:
                print(f'  FAILED: {e}')


