def get_dst_html(slug: str) -> Path:
    path = DST_DIR / f'{slug}.html'
    if not path.exists():
        sys.exit(
            f'Built essay not found: {path}\n'
            f'Run: python3 {SCRIPTS_DIR}/build-essays.py'
        )
    return path


def extract_intro(slug: str) -> tuple[str, str]:
    """Return (title, first_paragraph) from the built essay HTML."""
    soup = BeautifulSoup(get_dst_html(slug).read_text(encoding='utf-8'), 'html.parser')
    h1 = soup.find('h1')
    title = h1.get_text(strip=True) if h1 else slug
    intro = ''
    for el in (soup.find('main') or soup.find('body') or soup).find_all('p'):
        text = el.get_text(' ', strip=True)
        if text:
            intro = text
            break
    return title, intro


# ---------------------------------------------------------------------------
# Image adaptation
# ---------------------------------------------------------------------------

def adapt_image(source: Path, context: str, slug: str, platform: str,
                dry_run: bool) -> Path | None:
    fmt = 'jpg' if context in ('facebook-landscape', 'substack-cover') else 'png'
    if dry_run:
        out = TMP / f'hydra-img-{context}.{fmt}'
        cmd = [str(BIN / 'hydra-adapt-image'), str(source), context, '--out', str(out)]
        print(f'  Adapting image for {context} -> {out.name}...')
        print(f'  [dry-run] {" ".join(cmd)}')
        return out

    # Render to a temp path first so we can hash-compare before committing.
    TMP.mkdir(parents=True, exist_ok=True)
    tmp_out = TMP / f'hydra-img-{context}-tmp.{fmt}'
    cmd = [str(BIN / 'hydra-adapt-image'), str(source), context, '--out', str(tmp_out)]
    print(f'  Adapting image for {context}...')
    # Strip PYTHONPATH: the caller (hydra-publish) may run on python3.14 with
    # python3.11 site-packages injected for html2text, which breaks PIL's
    # _imaging C extension inside hydra-adapt-image. It needs its own clean env.
    adapt_env = {k: v for k, v in os.environ.items() if k != 'PYTHONPATH'}
    # timeout=300 per CODE.md 3.5 -- a hung adapt must not hang the publish.
    result = subprocess.run(cmd, env=adapt_env, timeout=300)
    if result.returncode != 0:
        print(f'  WARNING: image adaptation failed for {context}')
        return None

    # Skip saving if the output is byte-for-byte identical to the latest existing version.
    d = essay_dir(slug)
    latest = _latest_versioned(d, slug, platform, fmt)
    if latest:
        new_hash  = hashlib.md5(tmp_out.read_bytes()).hexdigest()
        prev_hash = hashlib.md5(latest.read_bytes()).hexdigest()
        if new_hash == prev_hash:
            tmp_out.unlink()
            print(f'  Image unchanged -- reusing {latest.name}')
            return latest

    d.mkdir(parents=True, exist_ok=True)
    version  = next_asset_version(slug, platform)
    date_str = str(date.today())
    out = d / f'{slug}-{platform}-v{version}-{date_str}.{fmt}'
    tmp_out.rename(out)
    print(f'  Saved: {out.name}')
    return out


