def _resolve_platforms(args) -> list[str]:
    if getattr(args, 'all', False):
        return ALL_PLATFORMS[:]
    if getattr(args, 'platforms', None):
        platforms = [x.strip() for x in args.platforms.split(',')]
        unknown = [x for x in platforms if x not in ALL_PLATFORMS]
        if unknown:
            sys.exit(f'Unknown platform(s): {", ".join(unknown)}\n'
                     f'Valid: {", ".join(ALL_PLATFORMS)}')
        return platforms
    return []


def _normalize_post_type(raw: str | None) -> str:
    if raw in ('note', 'shortnote', 'longnote'):
        return 'article' if raw == 'longnote' else 'tweet'
    return raw or 'article'


def _build_ctx(args, slug: str) -> dict:
    ctx = {
        'tmp_dir': str(TMP),
        'essay_dir': str(essay_dir(slug)),
        'dry_run': args.dry_run,
        'account': args.account or 'archerships',
        'destination': args.destination or 'profile',
        'yes': getattr(args, 'yes', False),
    }
    # Odysee extended publish options (passed through to the plugin's
    # _claim_params; harmless for other platforms, which ignore them).
    for opt, key in [('visibility', 'odysee_visibility'),
                     ('tags', 'odysee_tags'),
                     ('description', 'odysee_description'),
                     ('release_time', 'odysee_release_time'),
                     ('license', 'odysee_license'),
                     ('license_url', 'odysee_license_url')]:
        val = getattr(args, opt, None)
        if val is not None:
            ctx[key] = val
    contact = ARCHERSHIPS / 'prj' / 'hydra' / 'publish' / 'config' / 'fb-contact.txt'
    ctx['contact_file'] = str(contact if contact.exists()
                              else Path.home() / 'av' / 'prj' / 'hydra' / 'publish' / 'config' / 'fb-contact.txt')
    return ctx


def _load_post(args, slug: str) -> dict:
    """Build the normalized Post dict from the essay source."""
    fm = read_frontmatter(slug)
    title, intro = extract_intro(slug)
    return {
        'title': fm.get('title', title or slug),
        'body': intro,
        'cover_image': str(args.image) if args.image else '',
        'tags': fm.get('tags') or [],
        'url': f'{BASE_URL}/{slug}.html',
        'slug': slug,
        'post_type': _normalize_post_type(args.post_type),
    }


def _load_post_from_repo(args, slug: str) -> dict:
    """Build the normalized Post dict from the REPO source of truth.

    Reads SLUG/SLUG.md directly (frontmatter + body markdown), not the
    built HTML -- per D10, the markdown + images in ~/av/doc/posts/ are
    authoritative. The body is the raw markdown; platforms that need
    plain text strip markup themselves (facebook) or get full markdown
    (nostr/substack).
    """
    md_path = find_source_md(slug)
    if not md_path.exists():
        sys.exit(f'Essay not found in repo: {md_path}')

    text = md_path.read_text(encoding='utf-8')
    try:
        fm_yaml, body = _split_frontmatter(text)
        fm = yaml.safe_load(fm_yaml) or {}
    except (ValueError, yaml.YAMLError) as exc:
        sys.exit(f'Could not parse frontmatter for {slug}: {exc}')

    # Cover image: explicit hero_image frontmatter wins, else the first
    # image referenced in the body, else the highest-versioned cover file.
    cover = str(args.image) if args.image else ''
    if not cover:
        hero = fm.get('hero_image')
        if hero:
            candidate = essay_dir(slug) / str(hero)
            if candidate.exists():
                cover = str(candidate)
    if not cover:
        cover_img = find_cover_image(slug)
        if cover_img:
            cover = str(cover_img)

    return {
        'title': fm.get('title', slug),
        'body': body.strip(),
        'cover_image': cover,
        'tags': fm.get('tags') or [],
        'url': f'{BASE_URL}/{slug}.html',
        'slug': slug,
        'post_type': _normalize_post_type(args.post_type),
        'updated_at': fm.get('date', ''),
    }


def _crud_imports():
    """Import hydra_crud lazily so legacy create paths still work without it."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
