def main() -> None:
    parser = argparse.ArgumentParser(
        description='Cross-post an archerships.com essay to multiple platforms.'
    )
    sub = parser.add_subparsers(dest='command', metavar='COMMAND')

    # ── create (legacy default behavior) ────────────────────────────────
    p_create = sub.add_parser('create', help='Publish a new post to platforms')
    p_create.add_argument('slug', help='Essay slug (stem of ~/av/doc/posts/SLUG/SLUG.md)')
    _add_platform_args(p_create)
    _add_crud_common(p_create)
    p_create.set_defaults(func=cmd_create)

    # ── read ────────────────────────────────────────────────────────────
    p_read = sub.add_parser('read', help='Check post status on platforms')
    p_read.add_argument('slug', help='Essay slug')
    _add_platform_args(p_read)
    _add_crud_common(p_read)
    p_read.set_defaults(func=cmd_read)

    # ── update ──────────────────────────────────────────────────────────
    p_update = sub.add_parser('update', help='Update existing posts on platforms')
    p_update.add_argument('slug', help='Essay slug')
    _add_platform_args(p_update)
    _add_crud_common(p_update)
    p_update.set_defaults(func=cmd_update)

    # ── delete ──────────────────────────────────────────────────────────
    p_delete = sub.add_parser('delete', help='Delete posts from platforms (irreversible)')
    p_delete.add_argument('slug', help='Essay slug')
    _add_platform_args(p_delete)
    _add_crud_common(p_delete)
    p_delete.add_argument('--yes', action='store_true',
                          help='Skip per-platform confirmation prompts')
    p_delete.set_defaults(func=cmd_delete)

    # ── list ────────────────────────────────────────────────────────────
    p_list = sub.add_parser('list', help='List posts on a platform')
    p_list.add_argument('--platform', required=True,
                        help=f'Platform to list (e.g. facebook)')
    _add_crud_common(p_list)
    p_list.set_defaults(func=cmd_list)

    # ── sync ─────────────────────────────────────────────────────────────
    p_sync = sub.add_parser('sync',
                            help='Sync a post from SRC to one or more DST platforms (upsert)')
    p_sync.add_argument('slug', help='Essay slug')
    _add_crud_common(p_sync)
    p_sync.add_argument('--from', dest='src', default='repo',
                        help='Source platform (default: repo -- the md+images source of truth)')
    p_sync.add_argument('--to', dest='dst', required=True,
                        help='Comma-separated destination platforms')
    p_sync.set_defaults(func=cmd_sync)

    # ── propagate ───────────────────────────────────────────────────────
    p_prop = sub.add_parser('propagate',
                            help='Update every platform with a ref; create for the rest')
    p_prop.add_argument('slug', help='Essay slug')
    _add_crud_common(p_prop)
    p_prop.add_argument('--include-new', action='store_true',
                        help='Also create posts on platforms without a ref')
    p_prop.set_defaults(func=cmd_propagate)

    args = parser.parse_args()

    if not getattr(args, 'command', None):
        parser.print_help()
        sys.exit(1)

    args.func(args)


