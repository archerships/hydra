#!/usr/bin/env python3
"""
fb-import -- Import a Facebook account archive from a DYI export.

Facebook does not provide a public API for reading Page or personal posts.
The only supported import path is the official "Download Your Information"
(DYI) export from Settings > Your Facebook information > Download your information.

Request format: JSON. Select at minimum: Posts, Comments, Reactions.
Facebook emails a link when the archive is ready (usually within minutes).

This script parses the DYI export and saves normalized records to:
  ~/av/doc/facebook/posts/        personal posts
  ~/av/doc/facebook/page-posts/   Page posts (if present in export)
  ~/av/doc/facebook/comments/     comments on others' posts

Usage:
  fb-import.py --export DIR

Options:
  --export DIR   Path to the unzipped DYI export directory
  --dry-run      Show what would be saved without writing files
"""

import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

OUT_BASE = Path.home() / "av/doc/facebook"


def decode_fb_text(s: str) -> str:
    # Facebook incorrectly encodes Unicode as Latin-1 in JSON exports.
    try:
        return s.encode("latin-1").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return s


def ts_to_iso(ts: int) -> str:
    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def save_post(record: dict, out_dir: Path, dry_run: bool) -> str | None:
    ts = record.get("timestamp")
    if not ts:
        return None

    iso = ts_to_iso(ts)
    slug = f"{iso[:10]}-{ts}"
    post_path = out_dir / slug

    if dry_run:
        print(f"  [dry-run] would write {post_path}/post.json")
        return slug

    post_path.mkdir(parents=True, exist_ok=True)
    (post_path / "post.json").write_text(
        json.dumps(record, indent=2, ensure_ascii=False), encoding="utf-8"
    )

    data = record.get("data", [{}])
    text = ""
    for item in data:
        if "post" in item:
            text = decode_fb_text(item["post"])
            break

    if text:
        (post_path / "body.txt").write_text(text, encoding="utf-8")

    return slug


def load_posts_file(path: Path) -> list[dict]:
    try:
        raw = json.loads(path.read_bytes())
    except Exception as e:
        print(f"  [WARN] Could not read {path}: {e}", file=sys.stderr)
        return []

    if isinstance(raw, list):
        return raw
    if isinstance(raw, dict):
        for key in ("posts_v2", "posts", "data"):
            if key in raw and isinstance(raw[key], list):
                return raw[key]
    return []


def main():
    parser = argparse.ArgumentParser(description="Import Facebook DYI export")
    parser.add_argument("--export", required=True, help="Path to unzipped DYI export")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    export = Path(args.export).expanduser()
    if not export.is_dir():
        print(f"[fb-import] ERROR: {export} is not a directory", file=sys.stderr)
        sys.exit(1)

    tasks = [
        (export / "your_posts" , OUT_BASE / "posts",      "personal posts"),
        (export / "posts"      , OUT_BASE / "posts",      "personal posts (alt path)"),
        (export / "page_posts" , OUT_BASE / "page-posts", "Page posts"),
        (export / "comments"   , OUT_BASE / "comments",   "comments"),
    ]

    total = 0

    for src_dir, out_dir, label in tasks:
        if not src_dir.is_dir():
            continue

        json_files = sorted(src_dir.glob("*.json"))
        if not json_files:
            continue

        print(f"[fb-import] Importing {label} from {src_dir.name}/...")

        if not args.dry_run:
            out_dir.mkdir(parents=True, exist_ok=True)

        for jf in json_files:
            records = load_posts_file(jf)
            for rec in records:
                slug = save_post(rec, out_dir, args.dry_run)
                if slug:
                    total += 1

    if total == 0:
        print("[fb-import] No posts found. Check that --export points to the unzipped DYI root.")
        print("  Expected structure: <export>/your_posts/your_posts_1.json or")
        print("                      <export>/posts/your_posts_1.json")
        sys.exit(1)

    print(f"[fb-import] Done. {total} records {'would be ' if args.dry_run else ''}saved to {OUT_BASE}")


if __name__ == "__main__":
    main()
