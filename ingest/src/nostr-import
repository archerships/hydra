#!/usr/bin/env python3
"""
nostr-import -- Full historical fetch of Nostr events by pubkey.

Fetches all kind-1 (notes) and kind-30023 (long-form articles) events for
the configured pubkey from a list of relays, using nak.

Events are saved as individual JSON files. The relay list and pubkey are
read from the system keychain (same credentials used by nostr-publisher.py).

Usage:
  nostr-import.py [--pubkey HEX] [--kinds K[,K...]] [--relays R[,R...]]
                  [--output DIR] [--dry-run]

Options:
  --pubkey HEX      Hex public key (default: derived from keychain private key)
  --kinds K[,K...]  Event kinds to fetch (default: 1,30023)
  --relays R[,R...] Relay URLs (default: built-in list)
  --output DIR      Output directory (default: ~/av/doc/nostr)
  --dry-run         Print nak command without executing
  --all             Include all event kinds for this pubkey

Requirements:
  nak  (go install github.com/fiatjaf/nak@latest; ~/go/bin must be on PATH)
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_RELAYS = [
    "wss://relay.damus.io",
    "wss://relay.primal.net",
    "wss://nos.lol",
    "wss://relay.nostr.band",
]
DEFAULT_KINDS = [1, 30023]
OUT_BASE = Path.home() / "av/doc/nostr"
CHECKPOINT = OUT_BASE / ".last-import"


def find_nak() -> str:
    nak = shutil.which("nak") or os.path.expanduser("~/go/bin/nak")
    if not Path(nak).exists():
        print(
            "[nostr-import] ERROR: nak not found.\n"
            "  Install: go install github.com/fiatjaf/nak@latest\n"
            "  Then add ~/go/bin to PATH.",
            file=sys.stderr,
        )
        sys.exit(1)
    return nak


def get_pubkey(nak: str) -> str | None:
    try:
        import keyring
        privkey = keyring.get_password("nostr", "private_key")
        if privkey:
            result = subprocess.run(
                [nak, "key", "public", privkey],
                capture_output=True, text=True, check=True,
            )
            return result.stdout.strip()
    except Exception:
        pass
    return None


def fetch_events(nak: str, pubkey: str, kinds: list[int], relays: list[str], dry_run: bool) -> list[dict]:
    kind_args = []
    for k in kinds:
        kind_args += ["-k", str(k)]

    cmd = [nak, "req", "-a", pubkey, "--stream"] + kind_args + relays

    if dry_run:
        print("[nostr-import] Would run:", " ".join(cmd))
        return []

    print(f"[nostr-import] Fetching events from {len(relays)} relays...")
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)

    events = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            continue

    return events


def save_event(event: dict, out_dir: Path) -> str:
    kind = event.get("kind", 0)
    created = event.get("created_at", 0)
    event_id = event.get("id", "unknown")

    dt = datetime.fromtimestamp(created, tz=timezone.utc)
    date_str = dt.strftime("%Y-%m-%d")
    slug = f"{date_str}-{event_id[:16]}"

    kind_dir = out_dir / f"kind-{kind}"
    kind_dir.mkdir(parents=True, exist_ok=True)
    out_path = kind_dir / f"{slug}.json"
    out_path.write_text(json.dumps(event, indent=2, ensure_ascii=False), encoding="utf-8")

    return dt.isoformat()


def main():
    parser = argparse.ArgumentParser(description="Full Nostr event import by pubkey")
    parser.add_argument("--pubkey", help="Hex public key")
    parser.add_argument("--kinds", default=",".join(str(k) for k in DEFAULT_KINDS))
    parser.add_argument("--relays", default=",".join(DEFAULT_RELAYS))
    parser.add_argument("--output", default=str(OUT_BASE))
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--all", dest="all_kinds", action="store_true")
    args = parser.parse_args()

    nak = find_nak()
    out_dir = Path(args.output).expanduser()

    pubkey = args.pubkey or get_pubkey(nak)
    if not pubkey:
        print(
            "[nostr-import] ERROR: no pubkey. Pass --pubkey HEX or store private key in keychain:\n"
            "  python3 -c \"import keyring; keyring.set_password('nostr', 'private_key', 'HEX')\"",
            file=sys.stderr,
        )
        sys.exit(1)

    kinds = [] if args.all_kinds else [int(k) for k in args.kinds.split(",")]
    relays = [r.strip() for r in args.relays.split(",")]

    events = fetch_events(nak, pubkey, kinds, relays, args.dry_run)

    if not events:
        if not args.dry_run:
            print("[nostr-import] No events returned.")
        return

    print(f"[nostr-import] {len(events)} events received.")

    seen = set()
    saved = 0
    newest = None

    for event in events:
        eid = event.get("id")
        if eid in seen:
            continue
        seen.add(eid)

        ts = save_event(event, out_dir)
        saved += 1
        if newest is None or ts > newest:
            newest = ts

    if newest and not args.dry_run:
        CHECKPOINT.write_text(newest)

    print(f"[nostr-import] {saved} events saved to {out_dir}")
    if newest:
        print(f"[nostr-import] Newest event: {newest}")


if __name__ == "__main__":
    main()
